{
	email {$ACME_EMAIL}

	servers {
		# Only trust forwarded headers coming from Cloudflare's edge, so that the real
		# visitor IP (CF-Connecting-IP) is preserved and cannot be spoofed by clients.
		# Source: https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Both hostnames are served identically. Canonical host / www redirect is decided
# by the app (SITE_URL) and Cloudflare; add a redirect here only if you need one.
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
