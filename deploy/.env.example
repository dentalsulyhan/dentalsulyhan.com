# Copy to deploy/.env (never commit it) and fill in. Used by deploy/docker-compose.yml.

# --- Domain / TLS ------------------------------------------------------------
SITE_DOMAIN=dentalsulyhan.com
SITE_URL=https://dentalsulyhan.com
ACME_EMAIL=

# --- Database (the password is placed into a URL: use letters and digits only) -
POSTGRES_DB=sulyhan
POSTGRES_USER=sulyhan
POSTGRES_PASSWORD=

# --- Payload -------------------------------------------------------------------
PAYLOAD_SECRET=
# Optional, falls back to PAYLOAD_SECRET. Header x-revalidate-secret for POST /api/revalidate
REVALIDATE_SECRET=

# --- Email (outbound ports 25/465 are often blocked on VPS: prefer 587) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_SKIP_VERIFY=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dental Sulyhan

# --- Cloudflare Turnstile ------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (media) ------------------------------------------------------
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
# Public URL of the bucket. Its hostname is allowed for next/image at BUILD time,
# so rebuild the image after changing it (e.g. when moving to a custom media domain).
R2_PUBLIC_BASE_URL=

# --- Analytics (optional) ---------------------------------------------------------
PLERDY_SITE_HASH=
PLERDY_SUID=
NEXT_PUBLIC_PLERDY_SITE_HASH=
NEXT_PUBLIC_PLERDY_SUID=
NEXT_PUBLIC_PLERDY_SCRIPT_URL=

# --- Backups ---------------------------------------------------------------------
# Dumps contain patient contact data, so they are always encrypted with this passphrase.
# Keep a copy of it OUTSIDE the server, without it the backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14
# Optional upload to a SEPARATE R2 bucket (not the media bucket)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=sulyhan
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
